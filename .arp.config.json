{
  "provider": "github",
  "release": {
    "prerelease": false,
    "releaseBranchPrefix": "feature/",
    "maxReleases": 10,
    "maxCommits": 100,
    "includeChores": false
  },
  "version": "v0.2.0",
  "versionPrefix": "v",
  "manifests": [
    {
      "path": ".",
      "type": "simple",
      "version": "0.2.0"
    },
    {
      "path": "README.md",
      "filetype": "text",
      "versionPatterns": [
        "ZeroWiggliness/another-release-please-action@([^<]+)"
      ]
    }
  ]
}
